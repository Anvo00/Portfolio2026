---
/**
 * Base layout — wraps every page.
 * Owns the <html>/<head>, loads global styles and preloads the display fonts.
 */
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Vito Giacobelli — Portfolio",
  description = "Portfolio di Vito Giacobelli — Graphic Designer e Web Developer, MA Graphic Design, Accademia Italiana (Firenze).",
} = Astro.props;
---

<!doctype html>
<html lang="it" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <!-- Flip off the no-js fallback ASAP so JS-driven animations can init. -->
    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload the two display fonts used above the fold -->
    <link
      rel="preload"
      href="/fonts/Gobold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Sora-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
  </head>

  <body>
    <slot />

    <script>
      // Smooth-scroll for in-page anchors. Done in JS (not CSS
      // scroll-behavior) so it doesn't interfere with ScrollTrigger scrubbing.
      document.addEventListener("click", (e) => {
        const link = (e.target as HTMLElement).closest('a[href^="#"]');
        if (!link) return;
        const id = link.getAttribute("href");
        if (!id || id.length < 2) return;
        const target = document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    </script>
  </body>
</html>
