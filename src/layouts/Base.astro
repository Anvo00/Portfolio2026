---
/**
 * Base layout — wraps every page.
 * Owns the <html>/<head>, loads global styles and preloads the display fonts.
 */
import "../styles/global.css";
import PageTransition from "../components/PageTransition.astro";
import { withBase } from "../lib/base";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Vito Giacobelli — Portfolio",
  description = "Portfolio di Vito Giacobelli — Graphic Designer e Web Developer, MA Graphic Design, Accademia Italiana (Firenze).",
} = Astro.props;

// CSS url() with a root-absolute path (e.g. "/fonts/x.woff2") is left
// untouched by Vite, so it never picks up the site's base ("/Portfolio2026").
// Background-image url()s are fixed with base-prefixed CSS custom properties
// (var() works fine there, it's tied to an element). @font-face is different:
// it isn't tied to an element, so var() is not supported inside it per spec —
// those rules are emitted here as literal, already-prefixed strings instead.
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const assetVarsCss = `:root {
  --pattern-blue: url(${base}/projects/monogram/Monogram_Pattern_Blue.svg);
  --pattern-low-opacity: url(${base}/projects/monogram/Monogram_Pattern_LowOpacity.svg);
}
@font-face {
  font-family: "Gobold";
  src: url(${base}/fonts/Gobold.woff2) format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Sora";
  src: url(${base}/fonts/Sora-Regular.woff2) format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Sora";
  src: url(${base}/fonts/Sora-Medium.woff2) format("woff2");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Sora";
  src: url(${base}/fonts/Sora-SemiBold.woff2) format("woff2");
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Sora";
  src: url(${base}/fonts/Sora-Bold.woff2) format("woff2");
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}`;
---

<!doctype html>
<html lang="it" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <!-- Flip off the no-js fallback ASAP so JS-driven animations can init. -->
    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>

    <!--
      Decide which intro/transition to play, BEFORE first paint (no flash):
        full → homepage opened fresh or refreshed  → full intro
        logo → navigated between pages (not project→project) → logo transition
        none → project→project, or a direct open/refresh of a non-home page
    -->
    <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
      (function () {
        // Strip the site base ("/Portfolio2026") so the path checks below work
        // the same whether the site is at the root or in a subfolder.
        var BASE = base.replace(/\/+$/, "");
        var strip = function (p) {
          p = p.replace(/\/+$/, "") || "/";
          if (BASE && p.indexOf(BASE) === 0) p = p.slice(BASE.length) || "/";
          return p;
        };
        var path = strip(location.pathname);
        var navEntry = performance.getEntriesByType("navigation")[0];
        var navType = navEntry ? navEntry.type : "navigate";
        var ref = null;
        try {
          if (document.referrer) {
            var u = new URL(document.referrer);
            if (u.origin === location.origin) ref = strip(u.pathname);
          }
        } catch (e) {}

        var isHome = path === "/";
        var isProject = path.indexOf("/progetti/") === 0;
        var refIsProject = !!ref && ref.indexOf("/progetti/") === 0;
        var cameInternally = !!ref && ref !== path;
        var projectToProject = isProject && refIsProject;

        var mode;
        if (isHome && (navType === "reload" || (!cameInternally && navType !== "back_forward"))) {
          mode = "full";
        } else if (cameInternally && !projectToProject) {
          mode = "logo";
        } else {
          mode = "none";
        }
        document.documentElement.dataset.transition = mode;

        // Browsers auto-restore the previous scroll position on reload (and on
        // fresh loads of a URL visited before). Disable that except on real
        // back/forward navigation, where restoring scroll is expected.
        if (history.scrollRestoration) {
          history.scrollRestoration = navType === "back_forward" ? "auto" : "manual";
        }
        if (navType !== "back_forward") window.scrollTo(0, 0);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <style set:html={assetVarsCss}></style>

    <!-- Preload the two display fonts used above the fold -->
    <link
      rel="preload"
      href={withBase("/fonts/Gobold.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase("/fonts/Sora-SemiBold.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
  </head>

  <body>
    <!-- Logo-only transition overlay (shown on "logo" navigations). -->
    <PageTransition />

    <slot />

    <script>
      // Smooth-scroll for in-page anchors. Done in JS (not CSS scroll-behavior)
      // so it doesn't interfere with ScrollTrigger scrubbing. Handles both bare
      // "#id" and absolute "/#id" / "/" links: if they resolve to the CURRENT
      // page we scroll smoothly; links to a different page navigate normally
      // (so nav links work from project pages too).
      document.addEventListener("click", (e) => {
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>("a[href]");
        if (!link || link.target === "_blank") return;
        const href = link.getAttribute("href");
        if (!href) return;
        const url = new URL(href, location.href);
        // Different page → let the browser navigate.
        if (url.pathname !== location.pathname || url.search !== location.search) return;

        if (url.hash.length > 1) {
          const target = document.querySelector(url.hash);
          if (!target) return; // anchor not on this page — leave it to the browser
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          history.pushState(null, "", url.hash);
        } else if (!url.hash) {
          // Same page, no anchor (e.g. logo / "HOME" → "/") → scroll to top.
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      });
    </script>
  </body>
</html>
