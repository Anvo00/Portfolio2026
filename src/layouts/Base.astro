---
/**
 * Base layout — wraps every page.
 * Owns the <html>/<head>, loads global styles and preloads the display fonts.
 */
import "../styles/global.css";
import PageTransition from "../components/PageTransition.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Vito Giacobelli — Portfolio",
  description = "Portfolio di Vito Giacobelli — Graphic Designer e Web Developer, MA Graphic Design, Accademia Italiana (Firenze).",
} = Astro.props;
---

<!doctype html>
<html lang="it" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <!-- Flip off the no-js fallback ASAP so JS-driven animations can init. -->
    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>

    <!--
      Decide which intro/transition to play, BEFORE first paint (no flash):
        full → homepage opened fresh or refreshed  → full intro
        logo → navigated between pages (not project→project) → logo transition
        none → project→project, or a direct open/refresh of a non-home page
    -->
    <script is:inline>
      (function () {
        var path = location.pathname.replace(/\/+$/, "") || "/";
        var navEntry = performance.getEntriesByType("navigation")[0];
        var navType = navEntry ? navEntry.type : "navigate";
        var ref = null;
        try {
          if (document.referrer) {
            var u = new URL(document.referrer);
            if (u.origin === location.origin) ref = u.pathname.replace(/\/+$/, "") || "/";
          }
        } catch (e) {}

        var isHome = path === "/";
        var isProject = path.indexOf("/progetti/") === 0;
        var refIsProject = !!ref && ref.indexOf("/progetti/") === 0;
        var cameInternally = !!ref && ref !== path;
        var projectToProject = isProject && refIsProject;

        var mode;
        if (isHome && (navType === "reload" || (!cameInternally && navType !== "back_forward"))) {
          mode = "full";
        } else if (cameInternally && !projectToProject) {
          mode = "logo";
        } else {
          mode = "none";
        }
        document.documentElement.dataset.transition = mode;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload the two display fonts used above the fold -->
    <link
      rel="preload"
      href="/fonts/Gobold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Sora-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
  </head>

  <body>
    <!-- Logo-only transition overlay (shown on "logo" navigations). -->
    <PageTransition />

    <slot />

    <script>
      // Smooth-scroll for in-page anchors. Done in JS (not CSS
      // scroll-behavior) so it doesn't interfere with ScrollTrigger scrubbing.
      document.addEventListener("click", (e) => {
        const link = (e.target as HTMLElement).closest('a[href^="#"]');
        if (!link) return;
        const id = link.getAttribute("href");
        if (!id || id.length < 2) return;
        const target = document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    </script>
  </body>
</html>
