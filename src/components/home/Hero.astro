---
import "../../styles/hero.css";
import { Image } from "astro:assets";
import catJump from "../../assets/cat_jump.png";
import mousePointer from "../../assets/mouse_pointer.png";
import earphone from "../../assets/earphone.png";
import { withBase } from "../../lib/base";
---

<section class="hero section" id="home">
  <!-- Monogram background -->
  <div class="hero_bg" aria-hidden="true"></div>

  <div class="container hero_inner">
    <!-- Wordmark + decorations -->
    <h1 class="hero_title">
      <span class="sr-only">Portfolio</span>
      <span class="hero_stage" aria-hidden="true">
        <img
          class="hero_title-img"
          src={withBase("/images/portfolio_title.svg")}
          alt=""
          width="1288"
          height="473"
          fetchpriority="high"
          decoding="async"
        />
        <!-- Decoration images: imported for Astro's WebP + resize pipeline.
             width= is the 2× rendered size so retina screens get sharp edges. -->
        <Image
          class="hero_deco hero_deco--cat"
          src={catJump}
          alt=""
          width={436}
          loading="eager"
        />
        <Image
          class="hero_deco hero_deco--pointer"
          src={mousePointer}
          alt=""
          width={148}
          loading="eager"
        />
        <Image
          class="hero_deco hero_deco--audio"
          src={earphone}
          alt=""
          width={436}
          loading="eager"
        />
      </span>
    </h1>

    <!-- "Scorri per conoscermi" -->
    <a href="#about" class="hero_scroll" aria-label="Scorri per conoscermi">
      <span class="hero_scroll-label">SCORRI PER CONOSCERMI</span>
      <span class="hero_scroll-icon" aria-hidden="true">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="24" cy="24" r="23" stroke="currentColor" stroke-width="1.5"></circle>
          <path
            d="M24 15V33M24 33L18 27M24 33L30 27"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>
  </div>

  <!-- Pie di pagina -->
  <div class="container hero_meta">
    <span class="hero_meta-left">Portfolio @2026</span>
    <span class="hero_meta-right">Vito Giacobelli</span>
  </div>
</section>
