---
/**
 * Projects — scroll-pinned "vinyl turntable" project browser.
 *
 * A self-contained block: drop it anywhere on a page. The STAGE pins itself
 * when it reaches the centre of the viewport (the "Progetti" title stays above,
 * outside the pinned frame) and the scroll scrubs the scene. Snapping makes it
 * settle on each project — scroll, it pauses, then advances to the next.
 * Every step advances one project:
 *
 *   • the LEFT slider handle drops one notch and its number counts up (01…N)
 *   • the CENTRE vinyl rotates a few degrees
 *   • the RIGHT folder slides up under a mask while the next folder rises from
 *     the bottom into its place
 *   • the active YEAR badge (2025 / 2026) follows the current project
 *
 * When the last project is reached the stage unpins and the page continues.
 * Order + links are defined below; the step count adapts to the list length.
 *
 * Reduced-motion users get the static resting composition (project 01, no pin).
 */
import "../../styles/projects.css";
import { projects } from "../../data/projects.js";

/* Year is the single source of truth in projects.js — look it up by page URL so
   the badge never drifts if a project's year changes there. */
const yearByUrl = Object.fromEntries(projects.map((p) => [p.url, p.year]));

/* The folders on the right, in display order. Each folder PNG links to its
   project page. (Folder art lives in /public/projects/…) */
const folders = [
  { img: "/projects/icebreaker_brief/Icebreaker_Brief@2x.png", url: "/progetti/icebreaker" },
  { img: "/projects/maschera/Maschera_Steinberg@2x.png", url: "/progetti/maschera-di-steinberg" },
  { img: "/projects/materia_prima/Materia_Prima@2x.png", url: "/progetti/materia-prima" },
  { img: "/projects/monogram/Monogramma_Pattern@2x.png", url: "/progetti/monogramma-e-pattern" },
  { img: "/projects/palazzo_strozzi/Palazzo_Strozzi@2x.png", url: "/progetti/palazzo-strozzi" },
  { img: "/projects/recreos/Recreos@2x.png", url: "/progetti/recreos" },
  { img: "/projects/recreos/Recreos_Booklet@2x.png", url: "/progetti/booklet-recreos" },
];

const steps = folders.map((f, i) => ({
  number: String(i + 1).padStart(2, "0"),
  url: f.url,
  img: f.img,
  year: yearByUrl[f.url] ?? "2025",
}));

const first = steps[0];
const count = steps.length;
---

<section class="projects section" id="progetti" data-projects-anim>
  <div class="projects_pin">
    <div class="container projects_inner">
      <h2 class="section-title">Progetti</h2>

      <!-- The stage pins (centred); data-count feeds the script the step total. -->
      <div class="projects_stage" data-count={count}>
        <!-- ============ LEFT: project-number slider ============ -->
        <div class="proj_slider" aria-hidden="true">
          <svg viewBox="0 0 163.33 315.78" xmlns="http://www.w3.org/2000/svg" class="proj_slider-svg">
            <!-- track -->
            <rect class="proj_slider-track" x="14.97" y=".5" width="70.47" height="314.78" rx="2" ry="2" />
            <!-- inner (blue) fill -->
            <rect class="proj_slider-fill" x="37.91" y="30.93" width="24.58" height="253.91" rx="2" ry="2" />
            <!-- thumb = handle + number; the script slides this group down -->
            <g class="proj_slider-thumb">
              <rect class="proj_slider-handle" x=".5" y="40.72" width="100.43" height="32.31" rx=".76" ry=".76" />
              <text class="proj_slider-num" x="114.94" y="68.4">{first.number}</text>
            </g>
          </svg>
          <span class="sr-only">Progetto {first.number}</span>
        </div>

        <!-- ============ CENTRE: turntable ============ -->
        <div class="proj_player">
          <img class="proj_vinyl" src="/images/projects/vinyl_turntable.svg" alt="" aria-hidden="true" />
          <img class="proj_arrow" src="/images/projects/arrow.svg" alt="" aria-hidden="true" />
          <img class="proj_testina" src="/images/projects/testina.svg" alt="" aria-hidden="true" />

          <!-- Year badges; the active one is highlighted, the other dimmed. -->
          <div class="proj_years" aria-hidden="true">
            <img class="proj_year" data-year="2025" src="/images/projects/button_2025.svg" alt="" />
            <img class="proj_year" data-year="2026" src="/images/projects/button_2026.svg" alt="" />
          </div>
        </div>

        <!-- ============ RIGHT: masked folder carousel ============
             The window is the mask; the track holds one folder per project and
             slides up a notch each step (current exits top, next enters bottom). -->
        <div class="proj_folder" aria-label="Progetti">
          <div class="proj_folder-track">
            {
              steps.map((s) => (
                <a class="proj_card" href={s.url} data-year={s.year} aria-label={`Apri il progetto ${s.number}`}>
                  <img class="proj_card-img" src={s.img} alt="" loading="eager" decoding="async" />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ---- Tunables (design feel) ----
  const DEG_PER_STEP = 45; // how far the vinyl turns per project
  const SLIDER_TRAVEL = 213; // how far the slider thumb drops, in SVG units
  const SCROLL_PER_STEP = 50; // scroll distance per project, in % of viewport

  // Track contexts so hot reload can tear everything down (otherwise dev HMR
  // stacks a fresh timeline/ScrollTrigger on top of the old one).
  const contexts: ReturnType<typeof gsap.context>[] = [];

  /** Build the pinned, scrubbed, snapping browser for one Projects section. */
  function build(section: HTMLElement) {
    const ctx = gsap.context(() => {
      const stage = section.querySelector<HTMLElement>(".projects_stage");
      const vinyl = section.querySelector<HTMLElement>(".proj_vinyl");
      const thumb = section.querySelector<SVGGElement>(".proj_slider-thumb");
      const numEl = section.querySelector<SVGTextElement>(".proj_slider-num");
      const track = section.querySelector<HTMLElement>(".proj_folder-track");
      const cards = section.querySelectorAll<HTMLElement>(".proj_card");
      const years = section.querySelectorAll<HTMLImageElement>(".proj_year");

      if (!stage || !vinyl || !thumb || !numEl || !track || !cards.length) return;

      const N = Number(stage.dataset.count) || cards.length;

      // Reduced-motion users keep the static CSS composition (project 01).
      const mm = gsap.matchMedia();

      mm.add("(prefers-reduced-motion: no-preference)", () => {
        gsap.set(vinyl, { transformOrigin: "50% 50%" });

        // quickSetters = cheap per-frame writes for the continuous props.
        const setVinyl = gsap.quickSetter(vinyl, "rotation", "deg");
        const setThumb = gsap.quickSetter(thumb, "y", "px"); // SVG user units
        const setTrack = gsap.quickSetter(track, "yPercent");

        let lastIdx = -1;

        /** Map scroll progress (0→1) onto every moving part. */
        function render(p: number) {
          // continuous motion
          setVinyl(p * N * DEG_PER_STEP);
          setThumb(p * SLIDER_TRAVEL);
          // slide the track up so the mask shows the current folder. The track
          // box is one card tall (its cards overflow below), so yPercent is
          // per-card: -100% moves up exactly one folder.
          setTrack(-(p * (N - 1)) * 100);

          // discrete: project number + active year — only fire on change.
          const idx = Math.min(N, Math.floor(p * N) + 1); // 1..N
          if (idx !== lastIdx) {
            lastIdx = idx;
            const activeYear = cards[idx - 1].dataset.year;
            numEl!.textContent = String(idx).padStart(2, "0");
            years.forEach((y) => y.classList.toggle("is-dim", y.dataset.year !== activeYear));
          }
        }

        ScrollTrigger.create({
          trigger: stage,
          // Start when the stage reaches the centre of the viewport, so the
          // "Progetti" title is left above (outside) the pinned frame.
          start: "center center",
          end: `+=${N * SCROLL_PER_STEP}%`,
          pin: stage,
          scrub: 0.6, // smooth, but still stops when the scroll stops
          // Snap to each project so the scene settles between steps: scroll,
          // it eases to a rest on the nearest project, then on to the next.
          snap: {
            snapTo: 1 / (N - 1),
            duration: { min: 0.2, max: 0.5 },
            delay: 0.06,
            ease: "power1.inOut",
          },
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => render(self.progress),
          onRefresh: (self) => render(self.progress),
        });

        render(0); // paint the initial (project 01) state
      });
    }, section);

    contexts.push(ctx);
  }

  // Initialise every Projects block on the page (once each).
  document.querySelectorAll<HTMLElement>("[data-projects-anim]").forEach((section) => {
    if (section.dataset.projInit) return;
    section.dataset.projInit = "1";
    build(section);
  });

  // Tear down cleanly on hot reload so timelines/ScrollTriggers never stack.
  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      contexts.forEach((c) => c.revert());
      contexts.length = 0;
      document.querySelectorAll<HTMLElement>("[data-projects-anim]").forEach((s) => delete s.dataset.projInit);
    });
  }
</script>
