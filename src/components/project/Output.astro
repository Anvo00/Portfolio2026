---
import "../../styles/project/output.css";
import { withBase } from "../../lib/base";

interface Props {
  count?: number;
  project?: { slug?: string; outputCaption?: string; outputImages?: string[] };
}
const { count = 5, project } = Astro.props;

const images = (project?.outputImages || []).map(withBase);
const total = images.length || count;
const modules = Array.from({ length: total }, (_, i) => images[i]);

const ph =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore.";

const caption = project?.outputCaption || ph;
---

<section class="poutput psection section" id="output">
  <div class="container psection_inner">
    <h2 class="section-title">Output</h2>
        {
      project?.slug === "recreos" && (
        <a
          class="poutput_cta"
          href="https://orientamento.accademiaitaliana.com/recreos-pasta-fresca-morioni?hs_preview=eMFfqwfW-212879341065"
          target="_blank"
          rel="noopener noreferrer"
        >
          VEDI QUI
        </a>
      )
    }
    <p class="pcaption">{caption}</p>

    <div class="poutput_grid" data-images={JSON.stringify(images)}>
      {
        modules.map((src, i) =>
          src ? (
            <button type="button" class="poutput_mod" data-full={src} data-index={i}>
              <img src={src} alt="" loading="lazy" />
            </button>
          ) : (
            <div class="poutput_mod placeholder" />
          ),
        )
      }
    </div>


  </div>
</section>

<script>
  const grid = document.querySelector<HTMLElement>(".poutput_grid");
  const images: string[] = JSON.parse(grid?.dataset.images || "[]");

  let isDown = false;
  let startX = 0;
  let startLeft = 0;
  let moved = 0;

  grid?.addEventListener("pointerdown", (e) => {
    if (e.pointerType !== "mouse") return;
    isDown = true;
    moved = 0;
    startX = e.clientX;
    startLeft = grid.scrollLeft;
    grid.classList.add("is-dragging");
  });

  window.addEventListener("pointermove", (e) => {
    if (!isDown || !grid) return;
    const dx = e.clientX - startX;
    moved = Math.max(moved, Math.abs(dx));
    grid.scrollLeft = startLeft - dx;
  });

  window.addEventListener("pointerup", () => {
    if (!isDown || !grid) return;
    isDown = false;
    grid.classList.remove("is-dragging");
  });

  grid?.addEventListener("click", (e) => {
    if (moved > 5) {
      e.preventDefault();
      return;
    }
    const btn = (e.target as HTMLElement).closest<HTMLElement>(".poutput_mod[data-full]");
    if (!btn?.dataset.full) return;
    document.dispatchEvent(
      new CustomEvent("project-lightbox:open", {
        detail: { images, index: Number(btn.dataset.index) || 0 },
      }),
    );
  });
</script>
