---
/**
 * Conclusion ("CONCLUSIONI") — blue section, white text. Title + subtitle
 * + two text columns (placeholder). Flows into the (also blue) Footer.
 */
import "../../styles/project/conclusion.css";

const ph =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.";
---

<section class="pconclusion psection section" id="conclusioni">
  <div class="container psection_inner">
    <div class="pconclusion_head">
      <h2 class="section-title">Conclusioni</h2>
      <p class="pconclusion_sub">Cosa ho imparato? Cosa posso migliorare?</p>
    </div>
    <div class="ptext-cols">
      <div><p>{ph}</p></div>
      <div><p>{ph}</p></div>
    </div>
  </div>
</section>
