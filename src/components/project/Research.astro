---
/**
 * Research ("RICERCA") — oversized faded title with a row of cards over it.
 * Cards (variable `count`) start stacked at centre and spring out into a fan
 * when the section scrolls into view (GSAP + IntersectionObserver). Hovering
 * a card lifts it. Inline transforms = the fanned "rest" pose (no-js fallback);
 * GSAP takes over to animate from a stacked start.
 */
import "../../styles/project/research.css";

interface Props {
  count?: number;
}
const { count = 5 } = Astro.props;

// Per-card fanned target, computed from its offset to the centre.
const mid = (count - 1) / 2;
const spacing = 150;
const cards = Array.from({ length: count }, (_, i) => {
  const off = i - mid;
  const x = Math.round(off * spacing);
  const rot = (i % 2 === 0 ? -7 : 6) + Math.round(off * -1.2);
  const y = Math.round((i % 2 === 0 ? 1 : -1) * (8 + Math.abs(off) * 5));
  return { x, y, rot };
});

const ph =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore.";
---

<section class="presearch psection section" id="ricerca">
  <div class="presearch_inner">
    <div class="presearch_stage">
      <h2 class="presearch_title" aria-label="Ricerca">Ricerca</h2>

      <div class="presearch_cards">
        {
          cards.map((card) => (
            <div
              class="presearch_card"
              data-dx={card.x}
              data-dy={card.y}
              data-dr={card.rot}
              style={`transform: translate(${card.x}px, ${card.y}px) rotate(${card.rot}deg)`}
            >
              <div class="presearch_card-inner placeholder" />
            </div>
          ))
        }
      </div>
    </div>

    <p class="pcaption container">{ph}</p>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  const section = document.querySelector<HTMLElement>("#ricerca");
  if (section) {
    const cards = section.querySelectorAll<HTMLElement>(".presearch_card");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reduce && cards.length) {
      // Start stacked at the centre, hidden.
      gsap.set(cards, { x: 0, y: 0, rotation: 0, scale: 0.85, opacity: 0 });

      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            // Promote to a GPU layer only for the reveal, then release it.
            gsap.set(cards, { willChange: "transform, opacity" });
            gsap.to(cards, {
              x: (i, t) => Number((t as HTMLElement).dataset.dx),
              y: (i, t) => Number((t as HTMLElement).dataset.dy),
              rotation: (i, t) => Number((t as HTMLElement).dataset.dr),
              scale: 1,
              opacity: 1,
              duration: 0.9,
              ease: "back.out(1.6)", // spring-like
              stagger: 0.12,
              onComplete: () => gsap.set(cards, { clearProps: "willChange" }),
            });
            io.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      io.observe(section);
    }
  }
</script>
