---
/**
 * Project hero — full-frame (100vh) cover card inset by 32px.
 * Holds: a BACK link, prev/next arrows that cycle through the projects,
 * the "PROGETTO N" label and the project title.
 * If project.heroImage is set, shows the cover image; otherwise shows a placeholder.
 */
import "../../styles/project/hero.css";
import { withBase } from "../../lib/base";

interface Props {
  project: { slug: string; name: string; heroImage?: string };
  index: number;
  prev: string;
  next: string;
}
const { project, index, prev, next } = Astro.props;
---

<section class="phero">
  <a class="phero_back" href={withBase("/")}>
    <span aria-hidden="true">✕</span> BACK
  </a>

  <a class="phero_arrow phero_arrow--prev" href={withBase(`/progetti/${prev}`)} aria-label="Progetto precedente">
    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" aria-hidden="true">
      <path d="M15 5L8 12l7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
  <a class="phero_arrow phero_arrow--next" href={withBase(`/progetti/${next}`)} aria-label="Progetto successivo">
    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" aria-hidden="true">
      <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>

  <div class="phero_card">
    {project.heroImage
      ? <img class="phero_cover" src={withBase(project.heroImage)} alt={project.name} />
      : <div class="phero_cover placeholder" aria-hidden="true"></div>
    }

    <div class="phero_caption">
      <span class="phero_index">PROGETTO {index}</span>
      <h1 class="phero_title">{project.name}</h1>
    </div>
  </div>
</section>
