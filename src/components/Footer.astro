---
import "../styles/footer.css";
import { Image } from "astro:assets";
import catLie from "../assets/cat_lie.png";
import { withBase } from "../lib/base";

const socials = [
  { label: "Instagram", href: "https://www.instagram.com/_sirvxto_/", icon: "/images/instagram.svg" },
  { label: "Behance", href: "https://www.behance.net/vitogiacobelli", icon: "/images/behance.svg" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/vito-giacobelli-27b1373a2", icon: "/images/linkedin.svg" },
];
---

<footer class="footer section" id="contatti">
  <div class="container footer_inner">
    <div class="footer_top">
      <!-- Contatti -->
      <div class="footer_col">
        <h2 class="footer_heading">Contatti</h2>
        <ul class="footer_list">
          <li><a href="tel:+393278968007">+39 3278968007</a></li>
          <li><a href="mailto:giacobellivito@gmail.com">giacobellivito@gmail.com</a></li>
        </ul>
      </div>

      <!-- Social networks -->
      <div class="footer_col">
        <h2 class="footer_heading">Social Networks</h2>
        <ul class="footer_socials">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
                  <img src={withBase(s.icon)} alt="" width="32" height="32" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Lying cat illustration -->
      <div class="footer_cat" aria-hidden="true">
        <Image src={catLie} alt="" width={600} loading="lazy" />
      </div>
    </div>
  </div>

  <!-- Oversized contact wordmark -->
  <h1 class="footer_big">
    CONTATTAMI
  </h1>
</footer>
