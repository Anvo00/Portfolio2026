---
import "../styles/navbar.css";

// Centre links shown in the full pill (top of page). Absolute targets so they
// work from any page (in-page ones smooth-scroll on the homepage — see Base).
// ABOUT points to the static /info page, not the homepage section.
const links = [
  { label: "HOME", href: "/" },
  { label: "ABOUT", href: "/info" },
  { label: "PROGETTI", href: "/#progetti" },
];

// Index rows (per the reference). Absolute targets so they work from any page.
const menu = [
  { label: "HOME", href: "/" },
  { label: "PROGETTI", href: "/#progetti" },
  { label: "ABOUT", href: "/info" },
];

// Decorative piano-key bars (left column). One black key sits centred on each
// line BETWEEN the white-key rows (plus a half-key on the top & bottom edges),
// so the cream gaps land over the row labels. `b` = black key vs cream gap;
// `f` = flex ratio (share of the column height). Generated from the row count so
// it always stays aligned if rows are added/removed.
const ROW_F = 30; // one white-key row's height
const KEY_F = 15; // a full black key's thickness (≈ half a row)
const keys = [];
for (let i = 0; i <= menu.length; i++) {
  const edge = i === 0 || i === menu.length;
  keys.push({ b: true, f: edge ? KEY_F / 2 : KEY_F }); // black key ON the row line
  if (i < menu.length) keys.push({ b: false, f: ROW_F - KEY_F }); // cream gap over the label
}
---

<header class="nav" data-nav>
  <div class="container nav_container">
    <nav class="navbar" aria-label="Navigazione principale">
      <!-- LOGO (current monogram — will be swapped for the new Logo.svg) -->
      <a href="/" class="nav_logo" aria-label="Torna alla home">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="40"
          height="47"
          viewBox="0 0 48 56"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M47.9997 31.1151V36.3212C47.9997 36.4617 47.8861 36.5751 47.7454 36.5751H32.698L27.9568 39.4194L27.8491 39.4846L27.7237 39.5591L15.1667 47.094L11.4157 49.3449L10.0492 50.1652L0.387128 55.9622C0.151468 56.1036 -0.109623 55.8234 0.048049 55.599L7.4298 45.0717L13.3874 36.5751L15.3905 33.7181L16.2925 32.4314L16.0568 32.2892L13.6731 30.8611L13.5375 30.7807L13.1297 30.536L8.90394 28.0041L0.154011 22.7616C-0.0672378 22.6287 0.0268565 22.2901 0.284556 22.2901H23.4038L26.3029 18.1548L26.5038 17.8687L26.5759 17.7654L33.6965 7.60967L38.9557 0.108634C39.0981 -0.0945313 39.4185 0.00620484 39.4185 0.254236V27.7501C39.4185 27.8907 39.3049 28.0041 39.1642 28.0041H33.9508C33.8101 28.0041 33.6965 27.8907 33.6965 27.7501V18.104C33.6965 17.9381 33.4829 17.8712 33.388 18.0067L30.7644 21.7491L30.7059 21.8321L30.3846 22.2892L26.3784 28.0032H20.6369C20.4648 28.0032 20.4021 28.2293 20.5496 28.3173L24.499 30.6842L24.3753 30.8603L23.3741 32.2883L22.3722 33.7173L21.2091 35.3765L20.3699 36.5743L19.941 37.1855C19.8358 37.3353 20.0105 37.5215 20.1673 37.4276L21.5889 36.5743L22.3984 36.0884L24.4931 34.8321L24.9008 34.5866L26.3512 33.7173L27.9559 32.7548L28.7316 32.2883L31.1128 30.8603H47.7454C47.8861 30.8603 47.9997 30.9737 47.9997 31.1142V31.1151Z"
            fill="var(--white)"></path>
        </svg>
      </a>

      <!-- DESKTOP LINKS (centred) -->
      <ul class="nav_links">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>

      <!-- DESKTOP CTA -->
      <a href="#contatti" class="nav_cta nav_cta--desktop">CONTATTAMI</a>

      <!-- COLLAPSED TOGGLE — as the pill shrinks to the right it becomes this
           square button (morphing hamburger ↔ X). Also closes the open index. -->
      <button
        class="nav_menu-btn"
        aria-label="Apri il menu"
        aria-expanded="false"
        aria-controls="menu-index"
      >
        <svg
          class="menu-icon"
          viewBox="0 0 32 32"
          width="32"
          height="32"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            class="menu-icon_morph"
            d="M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22"
          ></path>
          <path d="M7 16 27 16"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<!-- FULLSCREEN INDEX OVERLAY (slides down from the top) -->
<div id="menu-index" class="menu" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true">
  <!-- Left: decorative piano-key bars (behind the rows). -->
  <div class="menu_keys" aria-hidden="true">
    {keys.map((k) => (
      <span class={`menu_key${k.b ? " is-black" : ""}`} style={`flex:${k.f}`}></span>
    ))}
  </div>

  <!-- Right: the three menu rows. -->
  <nav class="menu_rows" aria-label="Indice del sito">
    {menu.map((m) => (
      <a class="menu_row" href={m.href}>
        <span class="menu_label">{m.label}</span>
      </a>
    ))}
  </nav>
</div>

<script>
  const SCROLL_THRESHOLD = 70; // px scrolled before the pill collapses
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>(".nav_menu-btn");
  const overlay = document.getElementById("menu-index");

  /* ---- Collapse the pill into the corner button on scroll ----
     State lives on <html> (`nav-compact`) so the button — which sits outside
     the navbar's stacking context — can react to it too. */
  let compact = false;
  const onScroll = () => {
    if (root.dataset.transition === "full") return; // intro playing — stay expanded
    const next = window.scrollY > SCROLL_THRESHOLD;
    if (next !== compact) {
      compact = next;
      root.classList.toggle("nav-compact", compact);
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  /* ---- Open / close the fullscreen index ---- */
  if (btn && overlay) {
    const setOpen = (open: boolean) => {
      root.classList.toggle("menu-open", open);
      overlay.setAttribute("aria-hidden", String(!open));
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Chiudi il menu" : "Apri il menu");
    };

    btn.addEventListener("click", () => setOpen(!root.classList.contains("menu-open")));

    // Close on Escape.
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && root.classList.contains("menu-open")) setOpen(false);
    });

    // Close when a destination is picked (navigation then proceeds).
    overlay.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  }
</script>
