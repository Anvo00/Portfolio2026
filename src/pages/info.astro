---
import Base from "../layouts/Base.astro";
import "../styles/info.css";
import { withBase } from "../lib/base";

// Placeholder skill groups — edit freely (titles + items).
const skills = [
  {
    title: "Frontend",
    items: ["HTML / CSS", "JavaScript", "TypeScript", "Astro", "React", "Angular", "Bootstrap", ],
  },
  {
    title: "Animazione",
    items: ["GSAP", "Lenis", "CSS Animations"],
  },
  {
    title: "Design",
    items: ["Figma", "Illustrator", "Photoshop", "InDesign", "After Effects", "Procreate", "Blender"],
  },
  { title: "Strumenti", items: ["Git", "Next.js", "Vite", "Microsoft .NET"] },
];
---

<Base title="Info — Vito Giacobelli">
  <main class="info">
    <div class="info_stage" id="infoStage">
      <div class="info_grid">
        <!-- ============ LEFT COLUMN ============ -->
        <aside class="info_aside">
          <h1 class="info_title">about</h1>

          <figure class="info_photo">
            <img class="img-default"
              src={withBase("/images/personal_photo_about.jpg")}
              alt="Ritratto di Vito Giacobelli"
              width="1200"
              height="1800"
            />
            <span class="info_corner info_corner--tl"></span>
            <span class="info_corner info_corner--tr"></span>
            <span class="info_corner info_corner--bl"></span>
            <span class="info_corner info_corner--br"></span>
          </figure>

          <div class="info_asideFoot">
            <dl class="info_meta">
              <div class="info_metaRow">
                <dt class="info_metaLabel">Situato in</dt>
                <dd class="info_metaValue">Puglia, Italia</dd>
              </div>
              <div class="info_metaRow">
                <dt class="info_metaLabel">Studente</dt>
                <dd class="info_metaValue">
                  MA Graphic Design
                </dd>
              </div>
            </dl>

            <a
              class="info_email"
              href="mailto:vitogiacobelli@accademiaitaliana.it"
            >
              vitogiacobelli@accademiaitaliana.it
            </a>
          </div>
        </aside>

        <!-- ============ RIGHT COLUMN ============ -->
        <section class="info_main">
          <!--
          <a class="info_back" href="/">Indietro</a>
          -->

          <a class="phero_back" href={withBase("/")}>
            <span aria-hidden="true">✕</span> BACK
          </a>

          <div class="info_about">
            <h2 class="info_name">vito giacobelli.</h2>
            <p class="info_lead">
              Graphic Designer &amp; Web Developer, specializzato nel web
              design.
            </p>
            <p class="info_body">
              Creo esperienze su misura dove la precisione tecnica incontra
              l&rsquo;emozione. Appassionato di grafica, arte <br/> 
              e <em>musica</em>, cerco sempre la simbiosi tra <br/>
              reale ed immaginario.
            </p>
          </div>

          <div class="info_mainFoot">
            <hr class="info_divider" />

            <div class="info_skills">
              {
                skills.map((col) => (
                  <div class="info_skillCol">
                    <p class="info_skillTitle">{col.title}</p>
                    <ul class="info_skillList">
                      {col.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                ))
              }
        </section>
      </div>
    </div>
  </main>

  <script>
    const stage = document.getElementById("infoStage");

    function fitStage() {
      if (!stage || window.innerWidth <= 900) return;
      const margin = 24;
      const scaleX = (window.innerWidth - margin * 2) / stage.offsetWidth;
      const scaleY = (window.innerHeight - margin * 2) / stage.offsetHeight;
      const scale = Math.min(1, scaleX, scaleY);
      stage.style.setProperty("--info-scale", String(scale));
      stage.classList.add("is-ready");
    }

    fitStage();
    window.addEventListener("resize", fitStage);
    if ("fonts" in document) document.fonts.ready.then(fitStage);
  </script>
</Base>
